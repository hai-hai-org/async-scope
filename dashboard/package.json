{
  "name": "@asyncscope/dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "biome check src",
    "check:tokens": "! grep -rnE 'font-size: *[0-9]+px|font-weight: *[0-9]+|z-index: *[0-9]+' src --include=*.css | grep -v 'tokens.css' | grep -v 'fonts.css'"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-visually-hidden": "^1.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.1.3",
    "typescript": "^5.9.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7"
  }
}
